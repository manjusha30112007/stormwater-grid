              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mentorshipPairId\": 1,\n  \"title\": \"Mock Technical Interview: Distributed Systems\",\n  \"agenda\": \"System design for URL shortener, caching strategies, and load balancing.\",\n  \"scheduledTime\": \"2026-10-05T17:30:00\",\n  \"durationMinutes\": 60\n}"
            },
            "url": {
