              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"],
              "query": [
                {
                  "key": "mentorshipPairId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Complete Mentoring Session",
          "request": {
            "method": "PATCH",
