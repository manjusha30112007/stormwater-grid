    {
      "name": "8. Input Validation Edge Cases",
      "item": [
        {
          "name": "EDGE CASE: Invalid Email Format",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Email User\",\n  \"email\": \"not-a-valid-email\",\n  \"maxMentees\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/alumni",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alumni"]
            },
            "description": "Fails @Email validation -> returns 400 Bad Request with fieldErrors."
          }
        },
        {
          "name": "EDGE CASE: Max Mentees Less Than 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zero Slot Mentor\",\n  \"email\": \"zeroslot@example.com\",\n  \"maxMentees\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/alumni",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alumni"]
            },
            "description": "Fails @Min(1) validation -> returns 400 Bad Request."
          }
        },
        {
          "name": "EDGE CASE: Non-Existent Resource ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alumni/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alumni", "9999"]
            },
            "description": "Non-existent ID -> returns 404 Not Found."
          }
        }
      ]
    }
